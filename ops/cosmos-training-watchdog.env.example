# Install as /etc/cosmos-training-watchdog.env with mode 0600.
# LAMBDA_INSTANCE_ID may be omitted; the watchdog resolves it from EXPECTED_PUBLIC_IP.
EXPECTED_PUBLIC_IP=192.222.54.249
TRAINING_CONTAINER=cosmos-lehome-training
CHECKPOINT_S3_PREFIX=s3://policy-training/cosmos2b-wam-lehome/cosmos_v2_finetune/cosmos_predict2_2b_480p_lehome_100_demos_no_value_proprio_dropout50
TARGET_STEP=8000
INACTIVITY_SECONDS=1800
POLL_SECONDS=60
